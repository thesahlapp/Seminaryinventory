# Copy this file to .env.local and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API Keys  (and Data API for the URL)

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). The legacy "anon" key also works here.
# Safe to expose to the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_) or legacy service_role key.
# NOT used by the app yet; reserved for future admin features such as inviting
# users from inside the app. Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
