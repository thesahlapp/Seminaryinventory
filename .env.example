# Copy this file to .env.local and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API Keys  (and Data API for the URL)

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). The legacy "anon" key also works here.
# Safe to expose to the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OPTIONAL. Secret key (starts with sb_secret_) or legacy service_role key.
# Lets admins invite and remove people from Settings -> Users. Without it,
# invite people from the Supabase dashboard instead.
# Server-only and powerful: never prefix it with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=

# OPTIONAL: email (low stock digest, overdue reminders, @mentions) via Resend.
# Create an account at resend.com, verify your domain, then create an API key.
RESEND_API_KEY=
# Sender on your verified domain, e.g. "Qalam Inventory <inventory@yourdomain.org>"
EMAIL_FROM=

# OPTIONAL: protects the daily email job (/api/cron/daily). Any long random
# string; Vercel sends it automatically to scheduled jobs.
CRON_SECRET=

# OPTIONAL: the app's public address, used for links in emails and QR labels
# printed from a computer. On Vercel the production address is used automatically.
NEXT_PUBLIC_SITE_URL=
